  "main": "index.js",
  "scripts": {
    "build": "pnpm -r run build",
    "build:bbast": "pnpm --filter @onachi/bbast run build",
    "build:parser": "pnpm --filter @onachi/bbcode-parser run build",
    "test": "pnpm -r run test",
