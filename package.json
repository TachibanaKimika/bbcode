    "clean": "pnpm -r run clean",
    "type-check": "pnpm -r run type-check",
    "publish:patch": "node scripts/auto-publish.js patch",
    "publish:minor": "node scripts/auto-publish.js minor", 
    "publish:major": "node scripts/auto-publish.js major",
    "publish:beta": "node scripts/auto-publish.js beta",
    "test:publish": "node scripts/test-auto-publish.js",
